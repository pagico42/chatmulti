<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="#F0F0F0">

    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="6dp">

        <TextView
            android:id="@+id/tvChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#000000" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A: "
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spDestinatario"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnFile"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Invia File..."
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etMsg"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Scrivi messaggio..."
            android:singleLine="true"
            android:imeOptions="actionSend" />

        <Button
            android:id="@+id/btnInvia"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Invia" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <AutoCompleteTextView
            android:id="@+id/actvIpDest"
            android:layout_width="125dp"
            android:layout_height="40dp"
            android:hint="IP PC/Telefono"
            android:inputType="phone"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnConnetti"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Aggiungi PC"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pbFile"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:max="100" />

        <TextView
            android:id="@+id/tvProg"
            android:layout_width="35dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:gravity="right" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etNome"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.2"
            android:hint="Nome"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etCodice"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="0.8"
            android:text="1234"
            android:hint="Codice"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etPorta"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="0.8"
            android:text="5050"
            android:inputType="number"
            android:hint="Porta"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnInizia"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Attiva Chat"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnDisconnetti"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Disconnetti"
            android:enabled="false"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvMioIp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mio IP: ..."
            android:textColor="#00008B"
            android:textSize="12sp"
            android:gravity="right" />
    </LinearLayout>
</LinearLayout>
